docker {
  enabled = true
}

wave {
  enabled = true
  build.repository = 'docker.io/hrma017/test'
}

tower {
  accessToken = "$TOWER_ACCESS_TOKEN"
}

process {
  withName: 'generate_data' {
    container = 'alpine'
  }
  withName: 'quality_control' {
    container = 'alpine'
  }
  withName: 'compute_stats' {
    container = 'alpine'
  }
  withName: 'aggregate_results' {
    container = 'alpine'
  }
}

