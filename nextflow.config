docker {
  enabled = true
}

wave {
  enabled = true
  // build only: without 'container' in the strategy a process can never be served a plain
  // image, so every one of them is a Wave build request from its module Dockerfile
  strategy = ['dockerfile']
  build.repository = 'docker.io/hrma017/test'
}

tower {
  accessToken = "$TOWER_ACCESS_TOKEN"
}
